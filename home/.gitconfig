# Identity lives in ~/.gitconfig.local, which is generated by
# scripts/git-identity.sh and never committed.
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore
	editor = nvim

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[diff]
	colorMoved = zebra

[alias]
	st = status
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
